import { MathFormula } from '../../framework/Math'
import { useNumberFormat } from '../../framework/formatting'
import type { SimulationLessonProps } from '../../framework/types'

export function Lesson({ parameters, snapshot, time }: SimulationLessonProps) {
  const { format } = useNumberFormat()
  return <section className="equation-panel" aria-label="Linear response equations">
    <header className="equation-panel-heading"><div><span className="eyebrow">THE EQUATION / t = {format(time)} s</span><h2>Value and rate.</h2></div></header>
    <div className="equation-card">
      <MathFormula tex={String.raw`y(t)=y_0+rt,\qquad\frac{dy}{dt}=r`} />
      <p className="equation-note">The initial value y₀ and rate r stay fixed during a run. The current value y(t) changes with time.</p>
      <dl className="__MODEL_ID__-values">
        <div><dt>Initial value · y₀</dt><dd>{format(parameters.initial)}</dd></div>
        <div><dt>Rate · r</dt><dd>{format(parameters.rate)} s⁻¹</dd></div>
        <div><dt>Elapsed time · t</dt><dd>{format(time)} s</dd></div>
        <div><dt>Current value · y(t)</dt><dd>{format(snapshot.value)}</dd></div>
      </dl>
      <p className="equation-note" aria-label="Live substituted response">y({format(time)}) ≈ ({format(parameters.initial)}) + ({format(parameters.rate)}) × ({format(time)}) ≈ {format(snapshot.value)}</p>
      <p className="equation-note">This dimensionless example rises, falls, or holds according to the sign of its rate. The drawing rescales to fit the observation window.</p>
    </div>
  </section>
}
