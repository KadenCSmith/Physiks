{
  "name": "cinematic-app-framework",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts desktop",
    "test": "vitest run",
    "new:model": "node scripts/new-model.mjs",
    "check:models": "vitest run tests/model-health.test.ts",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:scaffold && npm test && npm run build",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:pack": "node scripts/desktop.mjs pack",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:test": "node scripts/desktop.mjs test"
  },
  "dependencies": {
    "katex": "0.18.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/katex": "0.16.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "An AI-ready React app template with a cinematic shell, model scaffold, validated model registry, Finder, Toolbox, and live learning panels."
}
