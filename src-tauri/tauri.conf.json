{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinematic App Framework",
  "identifier": "app.cinematic.cinematic-app-framework",
  "version": "../package.json",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["dmg", "nsis", "appimage"],
    "category": "Education",
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-", "hardenedRuntime": true },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false }, "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
